# Local frontend
VITE_EFH_API_BASE=http://127.0.0.1:8787

# Set to true for hosted/private beta frontend builds so the create-account modal asks for an access code.
VITE_EFH_PRIVATE_BETA=false

# Local API
E4H_API_HOST=127.0.0.1
E4H_API_PORT=8787
E4H_ALLOWED_ORIGINS=http://127.0.0.1:5177,http://localhost:5177

# Optional: require this shared code before someone can create a private-beta account.
# Do not commit the real value. Set it in Render/Railway/Supabase/Vercel environment settings.
E4H_BETA_ACCESS_CODE=

# Local JSON store by default. For hosted private beta use postgres with DATABASE_URL.
E4H_STORE=json
DATABASE_URL=
E4H_POSTGRES_SSL=true
E4H_POSTGRES_STATE_KEY=private-beta
