# Canonical interactive local app frontend
VITE_E4H_API_BASE=http://127.0.0.1:8787

# Local API
E4H_API_HOST=127.0.0.1
E4H_API_PORT=8787
E4H_ALLOWED_ORIGINS=http://127.0.0.1:5177,http://localhost:5177

# Local JSON store by default. The same canonical prototype can optionally use Postgres.
E4H_STORE=json
DATABASE_URL=
E4H_POSTGRES_SSL=true
E4H_POSTGRES_STATE_KEY=canonical-prototype
